const GAMES = RAW.flatMap((text,category)=>text.split('\n').map((line,i)=>{const [title,instructions,age,minutes,place,action]=line.split('|');return {id:category*20+i+1,title,instructions,age:+age,minutes:+minutes,place:place||'실내',action,category};}));
function eligibleGames(profile,place='all',duration=60){return GAMES.filter(g=>g.age<=profile.childAge&&g.minutes<=+duration&&(place==='all'||g.place===place));}
function gameWeight(g,profile){return 1+(String(g.category)===profile.childInterest?3:0)+(String(g.category)===profile.parentInterest?2:0)+(g.place==='야외'&&profile.parentAge>=70?-.5:0);}
function weightedPick(pool,profile,random=Math.random){let n=random()*pool.reduce((s,g)=>s+gameWeight(g,profile),0);return pool.find(g=>(n-=gameWeight(g,profile))<0)||pool[pool.length-1];}
if(typeof module!=='undefined')module.exports={GAMES,CATEGORIES,eligibleGames,gameWeight,weightedPick};
