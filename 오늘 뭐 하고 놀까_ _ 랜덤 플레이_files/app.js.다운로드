const $=s=>document.querySelector(s);
const read=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key))??fallback;}catch{return fallback;}};
let profiles=read('familyPlayProfiles',[]),history=read('familyPlayHistory',[]);
if(!Array.isArray(profiles))profiles=[];if(!Array.isArray(history))history=[];
let mode='roulette',busy=false,current=null,sound=false,audio=null,angle=0,startLane=0,rungs=[],timerId=null;
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
const pause=ms=>new Promise(resolve=>setTimeout(resolve,ms));
function toast(message){$('#toast').textContent=message;$('#toast').style.display='block';clearTimeout(toast.timeout);toast.timeout=setTimeout(()=>$('#toast').style.display='none',3000);}
function save(key,value){try{localStorage.setItem(key,JSON.stringify(value));return true;}catch{toast('브라우저 저장 공간을 사용할 수 없어요. 이번에는 저장 없이 즐겨요.');return false;}}
function tone(freq=500){if(!sound)return;try{audio??=new AudioContext();audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.connect(g);g.connect(audio.destination);o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(.055,audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+.16);o.start();o.stop(audio.currentTime+.17);}catch{}}
function profile(){return {name:$('#familyName').value.trim()||'우리 가족',parentAge:+$('#parentAge').value,childAge:+$('#childAge').value,parentGender:$('#parentGender').value,childGender:$('#childGender').value,parentInterest:$('#parentInterest').value,childInterest:$('#childInterest').value};}
function pool(){return eligibleGames(profile(),$('#place').value,$('#duration').value);}
function refresh(){const available=pool();$('#poolInfo').textContent=`우리 가족에게 맞는 ${available.length}가지 놀이가 기다리고 있어요`;
 $('#draw').disabled=busy||!available.length;}
function profilesUI(selected=''){const select=$('#profiles');select.replaceChildren(new Option('＋ 새 가족 만들기',''));profiles.forEach(p=>select.add(new Option(`${p.name} · ${p.childAge}세`,p.id)));select.value=selected;}
for(const id of ['parentInterest','childInterest']){const select=$('#'+id);select.add(new Option('모두 좋아요','all'));CATEGORIES.forEach((c,i)=>select.add(new Option(c.emoji+' '+c.name,String(i))));}
$('#profileForm').onsubmit=e=>{e.preventDefault();const p=profile();p.id=$('#profiles').value||crypto.randomUUID();const existing=profiles.findIndex(v=>v.id===p.id);if(existing<0)profiles.push(p);else profiles[existing]=p;const ok=save('familyPlayProfiles',profiles);profilesUI(p.id);if(ok)toast('우리 가족 설정을 저장했어요!');refresh();};
$('#profiles').onchange=()=>{const p=profiles.find(v=>v.id===$('#profiles').value);if(p){$('#familyName').value=p.name;for(const key of ['parentAge','childAge','parentGender','childGender','parentInterest','childInterest'])$('#'+key).value=p[key];}else{$('#profileForm').reset();}refresh();};
$('#profileForm').oninput=refresh;$('#place').onchange=refresh;$('#duration').onchange=refresh;
$('#sound').onclick=()=>{sound=!sound;$('#sound').textContent=sound?'♫ 소리 ON':'♫ 소리 OFF';$('#sound').setAttribute('aria-pressed',String(sound));tone(650);};
function renderStage(){const stage=$('#stage');stage.replaceChildren();if(mode==='roulette'){
 stage.innerHTML='<span class="spark">✧</span><span class="spark left">✦</span><div class="wheel-wrap"><div class="pointer"></div><div class="wheel"></div><div class="hub"><b>✳</b> LET’S PLAY</div></div>';
 const wheel=$('.wheel');wheel.style.background=`conic-gradient(${CATEGORIES.map((c,i)=>`${c.color} ${i*72}deg ${(i+1)*72}deg`).join(',')})`;wheel.style.transform=`rotate(${angle}deg)`;
 CATEGORIES.forEach((c,i)=>{const label=document.createElement('div');label.className='wheel-label';const a=i*72+36;label.style.transform=`rotate(${a}deg) translateY(-91px) rotate(${-a}deg)`;label.innerHTML=`${c.emoji}<small>${c.name}</small>`;wheel.append(label);});
 }else if(mode==='pachinko'){
 stage.innerHTML='<div class="machine"><div class="machine-title">LUCKY PLAY!</div><div class="pegboard"><div class="ball"></div></div><div class="bins">'+CATEGORIES.map(c=>`<span>${c.emoji}</span>`).join('')+'</div></div>';
 for(let row=0;row<5;row++)for(let col=0;col<6;col++){const peg=document.createElement('i');peg.className='peg';peg.style.left=`${12+col*15+(row%2?5:0)}%`;peg.style.top=`${28+row*29}px`;$('.pegboard').append(peg);}
 }else{
 rungs=Array.from({length:9},(_,i)=>({y:25+i*23,lane:Math.floor(Math.random()*4)}));
 stage.innerHTML='<div class="ladder-box"><p class="hint">출발 번호를 고르고 놀이 뽑기를 눌러요</p><div class="ladder-starts">'+Array.from({length:5},(_,i)=>`<button data-lane="${i}" class="${i===startLane?'active':''}" aria-pressed="${i===startLane}">${i+1}</button>`).join('')+'</div><svg viewBox="0 0 360 235" aria-label="다섯 갈래 사다리">'+Array.from({length:5},(_,i)=>`<path d="M ${30+i*75} 0 V 235" stroke="#d6c8e8" stroke-width="4"/>`).join('')+rungs.map(r=>`<path d="M ${30+r.lane*75} ${r.y} h 75" stroke="#d6c8e8" stroke-width="4"/>`).join('')+'<path id="ladderPath" fill="none" stroke="#7954c5" stroke-width="6" stroke-linecap="round"/></svg><div class="ladder-ends">'+Array.from({length:5},()=>'<span>🎁</span>').join('')+'</div></div>';
 document.querySelectorAll('[data-lane]').forEach(b=>b.onclick=()=>{if(busy)return;startLane=+b.dataset.lane;document.querySelectorAll('[data-lane]').forEach(v=>{v.classList.toggle('active',v===b);v.setAttribute('aria-pressed',String(v===b));});});
 }}
document.querySelectorAll('[data-mode]').forEach(button=>button.onclick=()=>{if(busy)return;mode=button.dataset.mode;document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-selected',String(b===button)));renderStage();tone(440);});
function lock(value){busy=value;document.querySelectorAll('#profileForm input,#profileForm select,#profileForm button,#profiles,#place,#duration,[data-mode],[data-lane],#libraryBtn').forEach(e=>e.disabled=value);$('#draw').textContent=value?'두근두근… 고르는 중!':'오늘의 놀이 뽑기 ↗';refresh();}
$('#draw').onclick=async()=>{if(busy||!$('#profileForm').reportValidity())return;const available=pool();if(!available.length)return;const p=profile();lock(true);tone(500);let chosen;
 try{if(mode==='ladder'){
 // The selected path determines its gift; gift assignments are randomized before traversal.
 const gifts=Array.from({length:5},()=>weightedPick(available,p));let lane=startLane;let path=`M ${30+lane*75} 0`;
 for(const r of rungs){path+=` V ${r.y}`;if(r.lane===lane)lane++;else if(r.lane+1===lane)lane--;path+=` H ${30+lane*75}`;}path+=' V 235';chosen=gifts[lane];const line=$('#ladderPath');line.setAttribute('d',path);const length=line.getTotalLength();line.style.strokeDasharray=length;line.style.strokeDashoffset=length;
 if(!reduced)await line.animate([{strokeDashoffset:length},{strokeDashoffset:0}],{duration:2400,fill:'forwards',easing:'linear'}).finished;line.style.strokeDashoffset=0;document.querySelectorAll('.ladder-ends span')[lane].textContent=CATEGORIES[chosen.category].emoji;
 }else{chosen=weightedPick(available,p);if(mode==='roulette'){const target=(360-(chosen.category*72+36))%360;angle+=1800+((target-angle%360+360)%360);$('.wheel').style.transform=`rotate(${angle}deg)`;await pause(reduced?100:3500);}else{const board=$('.pegboard'),ball=$('.ball');const width=board.clientWidth;const landing=(chosen.category+.5)*width/5-9;const frames=[{left:(width/2-9)+'px',top:'5px'}];for(let i=1;i<=5;i++)frames.push({left:Math.max(3,Math.min(width-22,width/2+(Math.random()-.5)*100+(landing-width/2)*i/5))+'px',top:(i*28)+'px'});frames.push({left:landing+'px',top:'163px'});if(!reduced)await ball.animate(frames,{duration:2200,fill:'forwards',easing:'linear'}).finished;ball.style.left=landing+'px';ball.style.top='163px';}}
 tone(780);await pause(reduced?0:250);showResult(chosen);
 }finally{lock(false);}};
const words=[['curious','호기심이 많은','I am curious. 나는 호기심이 많아요.'],['together','함께','We play together. 우리는 함께 놀아요.'],['brave','용감한','You are brave. 너는 용감해.'],['imagine','상상하다','Imagine a rainbow. 무지개를 상상해 봐.'],['kind','친절한','Be kind. 친절하게 대해요.'],['share','나누다','Let’s share. 함께 나누자.'],['smile','웃다 / 미소','Show me a smile. 미소를 보여 줘.'],['forest','숲','A green forest. 초록빛 숲.'],['wonderful','멋진','A wonderful day! 멋진 하루!'],['family','가족','I love my family. 나는 가족을 사랑해요.']];
const idioms=[['一石二鳥 · 일석이조','한 가지 일로 두 가지 이득을 얻어요.','산책하며 자연도 배우니 일석이조!'],['七顚八起 · 칠전팔기','여러 번 실패해도 다시 일어나 도전해요.','퍼즐이 어려워도 다시 해봐요.'],['有備無患 · 유비무환','미리 준비하면 걱정을 줄일 수 있어요.','소풍 전날 가방을 챙겨요.'],['十匙一飯 · 십시일반','여럿이 조금씩 힘을 모으면 큰 도움이 돼요.','가족이 함께 집을 정리해요.'],['以心傳心 · 이심전심','말하지 않아도 마음이 서로 통해요.','같은 놀이를 떠올렸어요.'],['大器晩成 · 대기만성','크게 될 사람은 오랜 노력 끝에 이루기도 해요.','조급해하지 말고 꾸준히 연습해요.'],['溫故知新 · 온고지신','옛것을 익혀 새로운 것을 알아요.','부모님의 옛 놀이로 새 놀이를 만들어요.'],['自業自得 · 자업자득','자기가 한 일의 결과를 스스로 받아요.','준비하지 않아 준비물이 없어요.']];
function clearTimer(){clearInterval(timerId);timerId=null;}
function showResult(game){clearTimer();current=game;$('#complete').disabled=false;$('#complete').textContent='다 했어요! ✨';const c=CATEGORIES[game.category];const container=$('#resultContent');container.innerHTML=`<div class="big-emoji">${c.emoji}</div><h2>${game.title}</h2><p class="badges">${c.name} · ${game.minutes}분 · ${game.place} · ${game.age}세부터</p><p class="instruction">${game.instructions}</p><div id="special"></div><button id="startTimer" class="extra">⏱ ${game.minutes}분 타이머 시작</button><div id="timer" role="timer"></div>`;
 const special=$('#special');if(game.action==='word'||game.action==='idiom'){const button=document.createElement('button');button.className='extra';button.textContent=game.action==='word'?'영어 단어 뽑기 ✨':'사자성어 뽑기 ✨';const content=document.createElement('p');content.className='learning';content.setAttribute('aria-live','polite');let last=-1;button.onclick=()=>{const list=game.action==='word'?words:idioms;let i;do{i=Math.floor(Math.random()*list.length);}while(i===last);last=i;content.replaceChildren();list[i].forEach((line,index)=>{const el=document.createElement(index===0?'strong':'div');el.textContent=line;content.append(el);});tone(600);};special.append(button,content);}else if(game.action){const a=document.createElement('a');a.className='extra';a.target='_blank';a.rel='noopener';a.href=game.action==='fruit'?'fruit-island/index.html':'https://www.duolingo.com/';a.textContent=game.action==='fruit'?'🍊 넌센스 과일섬 열기 ↗':'🌍 듀오링고 열기 ↗';special.append(a);}
 $('#startTimer').onclick=()=>{clearTimer();const end=Date.now()+game.minutes*60000;$('#startTimer').disabled=true;const tick=()=>{const seconds=Math.max(0,Math.ceil((end-Date.now())/1000));$('#timer').textContent=`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'0')}`;if(!seconds){clearTimer();$('#timer').textContent='시간 끝! 함께한 시간에 박수 👏';$('#startTimer').disabled=false;tone(900);}};tick();timerId=setInterval(tick,500);};$('#result').showModal();}
$('#complete').onclick=()=>{history.unshift({title:current.title,id:current.id,family:profile().name,date:new Date().toISOString()});history=history.slice(0,30);save('familyPlayHistory',history);renderHistory();$('#complete').disabled=true;$('#complete').textContent='멋져요! 오늘의 추억 +1 🎉';$('#resultContent').classList.add('celebrate');setTimeout(()=>$('#resultContent').classList.remove('celebrate'),600);tone(1000);clearTimer();};
function renderHistory(){const recent=$('#recent');recent.replaceChildren();if(history.length){const title=document.createElement('strong');title.textContent='함께 만든 추억';recent.append(title);history.slice(0,5).forEach(h=>{const span=document.createElement('span');span.textContent=`✓ ${h.title}`;span.title=`${h.family} · ${new Date(h.date).toLocaleDateString('ko-KR')}`;recent.append(span);});}}
document.querySelectorAll('dialog .close, .close-result').forEach(b=>b.onclick=()=>b.closest('dialog').close());$('#result').addEventListener('close',clearTimer);
function renderLibrary(){const query=$('#search').value.trim().toLowerCase();const list=$('#gamesList');list.replaceChildren();GAMES.filter(g=>(g.title+CATEGORIES[g.category].name).toLowerCase().includes(query)).forEach(g=>{const button=document.createElement('button');button.className='game-item';button.innerHTML=`${CATEGORIES[g.category].emoji} ${g.title}<small>${g.age}세부터 · ${g.minutes}분 · ${g.place}</small>`;button.onclick=()=>{if(!$('#profileForm').reportValidity()){$('#library').close();return;}if(g.age>profile().childAge){toast(`${g.age}세부터 추천하는 놀이예요. 나이에 맞는 다른 놀이를 골라주세요.`);return;}$('#library').close();showResult(g);};list.append(button);});if(!list.children.length)list.textContent='검색 결과가 없어요. 다른 단어로 찾아봐요.';}
